rules_version = '2';
// Règles de production (console Firebase → Firestore → Règles, relevées le
// 2026-09-23), moins l'accès en lecture du claim `preview`, retiré car aucun
// compte ne s'en sert et il exposait toute la base (dont la clé API IA de
// user_settings). Référence versionnée vérifiée par les tests émulateur.
// Le workflow deploy-functions publie aussi ces règles et indexes.
//
// Les Cloud Functions et scripts Python passent par l'Admin SDK, qui ignore
// ces règles : elles ne concernent que le front (SDK client).
//
// L'ancienne version de ce fichier (règles par collection, UID épinglé,
// validateurs de solde/placement) n'a jamais été déployée : elle bloquait 8
// collections utilisées par le front et la suppression de transactions.
service cloud.firestore {
  match /databases/{database}/documents {
    // Accès complet : le propriétaire, ou un compte dont l'email (vérifié) est
    // l'identifiant d'un document de `access_allowlist`. Cette liste se gère
    // uniquement depuis la console Firebase : aucun accès client.
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
             && (request.auth.token.email == "niveys@gmail.com"
                 || exists(/databases/$(database)/documents/access_allowlist/$(request.auth.token.email)));
    }
    function isBankingCollection(name) {
      return name in ['eb_sessions', 'eb_pending_auth', 'bank_observations',
        'bank_balance_sources', 'bank_balance_observations', 'bank_connections',
        'bank_reports', 'bank_sync_runs', 'bank_locks', 'bank_runtime', 'bank_canonical_aliases', 'bank_merge_history'];
    }
    match /bank_connections/{document} { allow read: if isOwner(); }
    match /bank_reports/{document} { allow read: if isOwner(); }
    match /bank_sync_runs/{document} { allow read: if isOwner(); }
    match /bank_runtime/{document} { allow read: if isOwner(); }
    match /recurring_expense_settings/{document=**} { allow read: if isOwner(); }
    // Réglages privés (clés d'API IA, GitHub, conversations de l'assistant,
    // préférences) : réservés au compte autorisé dont c'est l'UID.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }
    match /user_settings/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }
    // Journal des modifications : chaque ligne est signée de l'email et de l'UID
    // du compte connecté et datée par le serveur ; ni modification ni suppression.
    function isValidAuditEntry(data) {
      return data.keys().hasOnly(['at', 'byEmail', 'byUid', 'domain', 'action', 'path', 'docId', 'label', 'changes'])
             && data.keys().hasAll(['at', 'byEmail', 'byUid', 'domain', 'action', 'path', 'docId', 'label', 'changes'])
             && data.byEmail == request.auth.token.email
             && data.byUid == request.auth.uid
             && data.at == request.time
             && data.domain in ['transaction', 'budget', 'recurrence']
             && data.action in ['create', 'update', 'delete']
             && data.path is string && data.path.size() <= 500
             && data.docId is string && data.docId.size() <= 500
             && data.label is string && data.label.size() <= 300
             && data.changes is list && data.changes.size() <= 50;
    }
    match /audit_log/{entry} {
      allow read: if isOwner();
      allow create: if isOwner() && isValidAuditEntry(request.resource.data);
    }
    match /{collection}/{document=**} {

      // Propriétaire uniquement : lecture + écriture (recurring_expense_settings gelé en lecture seule)
      allow read, write: if !isBankingCollection(collection) && collection != 'recurring_expense_settings'
                         && collection != 'access_allowlist' && collection != 'audit_log'
                         && collection != 'users' && collection != 'user_settings'
                         && isOwner();
    }
  }
}
