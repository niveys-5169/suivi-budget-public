rules_version = '2';
// Règles de production (console Firebase → Firestore → Règles, relevées le
// 2026-09-23), moins l'accès en lecture du claim `preview`, retiré car aucun
// compte ne s'en sert et il exposait toute la base (dont la clé API IA de
// user_settings). Référence versionnée vérifiée par les tests émulateur.
// Le workflow deploy-functions publie aussi ces règles et indexes.
//
// Les Cloud Functions et scripts Python passent par l'Admin SDK, qui ignore
// ces règles : elles ne concernent que le front (SDK client).
//
// L'ancienne version de ce fichier (règles par collection, UID épinglé,
// validateurs de solde/placement) n'a jamais été déployée : elle bloquait 8
// collections utilisées par le front et la suppression de transactions.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "niveys@gmail.com"
             && request.auth.token.email_verified == true;
    }
    function isBankingCollection(name) {
      return name in ['eb_sessions', 'eb_pending_auth', 'bank_observations',
        'bank_balance_sources', 'bank_balance_observations', 'bank_connections',
        'bank_reports', 'bank_sync_runs', 'bank_locks', 'bank_runtime', 'bank_canonical_aliases', 'bank_merge_history'];
    }
    match /bank_connections/{document} { allow read: if isOwner(); }
    match /bank_reports/{document} { allow read: if isOwner(); }
    match /bank_sync_runs/{document} { allow read: if isOwner(); }
    match /bank_runtime/{document} { allow read: if isOwner(); }
    match /{collection}/{document=**} {

      // Propriétaire uniquement : lecture + écriture
      allow read, write: if !isBankingCollection(collection) && isOwner();
    }
  }
}
