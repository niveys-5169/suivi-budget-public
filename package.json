{
  "name": "suivi-budget-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:premium": "vite build --mode premium",
    "preview": "vite preview",
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs",
    "test:ui": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:design": "node scripts/check-design-system.mjs",
    "check:audit": "node scripts/check-npm-audit.mjs",
    "migrate-frontend": "node scripts/migrate_frontend.js",
    "analyze": "ANALYZE=true npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "0.20.3",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.73.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-intl": "^10.1.13",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "^2.23.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "playwright": "^1.60.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "uuid": "14.0.0",
    "undici": "7.29.0",
    "ai": "6.0.182",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-prometheus": "0.219.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "jsondiffpatch": "0.7.2",
    "fast-uri": "3.1.7",
    "hono": "4.12.25",
    "@ai-sdk/provider-utils": "4.0.28",
    "ip-address": "10.1.1",
    "esbuild": "$esbuild",
    "ws": "8.21.0",
    "protobufjs": "7.6.5",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "@babel/core": "8.0.1",
    "browserslist": "4.28.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
